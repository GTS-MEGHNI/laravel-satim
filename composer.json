{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gts-meghni/laravel-satim",
    "description": "Accept CIB and Edahabia card payments in Laravel through the Algerian SATIM gateway, with typed results, an audit trail, and multilingual receipts.",
    "keywords": [
        "laravel",
        "satim",
        "cib",
        "edahabia",
        "algeria",
        "payment",
        "payment-gateway",
        "epayment"
    ],
    "homepage": "https://github.com/gts-meghni/laravel-satim",
    "license": "MIT",
    "authors": [
        {
            "name": "GTS-MEGHNI",
            "email": "meghniucrpg@live.fr",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/gts-meghni/laravel-satim/issues",
        "source": "https://github.com/gts-meghni/laravel-satim"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "GtsMeghni\\Satim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GtsMeghni\\Satim\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "GtsMeghni\\Satim\\SatimServiceProvider"
            ],
            "aliases": {
                "Satim": "GtsMeghni\\Satim\\Facades\\Satim"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
